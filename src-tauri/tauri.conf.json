{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atmos",
  "version": "0.1.0",
  "identifier": "com.evanj.atmos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Atmos",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["atmos"],
        "name": "Atmos Project",
        "description": "Atmos molecular dynamics project file",
        "role": "Editor"
      },
      {
        "ext": ["nc", "ncrst"],
        "name": "AMBER Trajectory",
        "description": "AMBER MD trajectory file",
        "role": "Viewer"
      },
      {
        "ext": ["xtc", "trr"],
        "name": "GROMACS Trajectory",
        "description": "GROMACS MD trajectory file",
        "role": "Viewer"
      },
      {
        "ext": ["dcd"],
        "name": "DCD Trajectory",
        "description": "CHARMM/NAMD DCD trajectory file",
        "role": "Viewer"
      },
      {
        "ext": ["parm7", "prmtop"],
        "name": "AMBER Topology",
        "description": "AMBER topology file",
        "role": "Viewer"
      },
      {
        "ext": ["pdb"],
        "name": "PDB Structure",
        "description": "Protein Data Bank structure file",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "exceptionDomain": null,
      "signingIdentity": null,
      "providerShortName": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
