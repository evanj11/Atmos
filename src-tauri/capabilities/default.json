{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all Atmos windows",
  "windows": [
    "main",
    "ligand-builder",
    "visualizer",
    "umbrella-viewer-*",
    "analysis-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    "fs:allow-document-write-recursive",
    "fs:allow-download-write-recursive",
    "fs:allow-desktop-write-recursive",
    "fs:write-all"
  ]
}
